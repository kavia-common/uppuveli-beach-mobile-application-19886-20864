# Database environment configuration for the Database container (PostgreSQL)
# Copy this file to .env and update values as needed.
# Do NOT commit your actual .env with secrets.

# PUBLIC_INTERFACE
# PostgreSQL database name
POSTGRES_DB=myapp

# PUBLIC_INTERFACE
# PostgreSQL username
POSTGRES_USER=appuser

# PUBLIC_INTERFACE
# PostgreSQL user password
POSTGRES_PASSWORD=dbuser123

# PUBLIC_INTERFACE
# PostgreSQL port (default 5001 as per project requirement)
# Note: Some helper scripts in this repo default to 5000. Ensure consistency by setting this to the intended port.
POSTGRES_PORT=5001

# Optional: Host if connecting remotely (for local containers typically localhost)
# POSTGRES_HOST=localhost

# Optional: Full connection URL (overrides the above if used by tools)
# POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST:-localhost}:${POSTGRES_PORT}/${POSTGRES_DB}
