# Supabase Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# DUAL-DATABASE FEATURE FLAGS
# ============================================

# Master switch for Supabase (default: false)
# When true, enables Supabase for loyalty and referrals modules
SUPABASE_ENABLED=false

# Module-specific switches (override master switch)
# When enabled, loyalty operations route to Supabase
SUPABASE_LOYALTY_ENABLED=true

# When enabled, referrals operations route to Supabase
SUPABASE_REFERRALS_ENABLED=true

# Note: Users, Bookings, Payments, and Inventory always use local PostgreSQL

# ============================================
# SUPABASE CREDENTIALS
# ============================================

# Supabase Project URL
SUPABASE_URL=https://nlzykbtuyoqfdnqtxdyh.supabase.co

# Supabase Anon/Public Key (safe for client-side use)
# Used in React Native app, web frontend
# Get from: Supabase Dashboard > Settings > API
SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role Key (NEVER expose to clients!)
# Used only in secure backend/server environments
# Bypasses Row Level Security - use with caution
# Get from: Supabase Dashboard > Settings > API
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# LOCAL POSTGRESQL CONFIGURATION
# ============================================

# PostgreSQL connection details (for local database)
# Required for: Users, Bookings, Payments, Inventory modules
POSTGRES_URL=postgresql://appuser:dbuser123@localhost:5000/myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_DB=myapp
POSTGRES_PORT=5000

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Site URL for authentication redirects
# Development
SITE_URL=http://localhost:3000

# Production (uncomment and set for production deployment)
# SITE_URL=https://yourapp.com

# Node environment
NODE_ENV=development

# ============================================
# ADVANCED OPTIONS (Optional)
# ============================================

# Direct PostgreSQL connection string to Supabase (for migrations/admin tasks)
# Available in Supabase Dashboard > Settings > Database
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.nlzykbtuyoqfdnqtxdyh.supabase.co:5432/postgres

# ============================================
# CONFIGURATION GUIDE
# ============================================

# Scenario 1: All modules on local PostgreSQL (default)
#   SUPABASE_ENABLED=false
#   SUPABASE_LOYALTY_ENABLED=false
#   SUPABASE_REFERRALS_ENABLED=false

# Scenario 2: Loyalty and Referrals on Supabase, others on PostgreSQL (recommended)
#   SUPABASE_ENABLED=true
#   SUPABASE_LOYALTY_ENABLED=true
#   SUPABASE_REFERRALS_ENABLED=true
#   (Ensure SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are set)

# Scenario 3: Only Loyalty on Supabase
#   SUPABASE_ENABLED=false
#   SUPABASE_LOYALTY_ENABLED=true
#   SUPABASE_REFERRALS_ENABLED=false

# Scenario 4: Only Referrals on Supabase
#   SUPABASE_ENABLED=false
#   SUPABASE_LOYALTY_ENABLED=false
#   SUPABASE_REFERRALS_ENABLED=true

# For more information, see:
# - Database/MIGRATION_GUIDE.md (usage examples)
# - README.md (setup instructions)
