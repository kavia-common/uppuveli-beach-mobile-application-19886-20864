# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Supabase Project URL
SUPABASE_URL=https://nlzykbtuyoqfdnqtxdyh.supabase.co

# Supabase Anon/Public Key (safe for client-side use)
# Used in React Native app, web frontend
SUPABASE_ANON_KEY=your_anon_key_here

# Supabase Service Role Key (NEVER expose to clients!)
# Used only in secure backend/server environments
# Bypasses Row Level Security - use with caution
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional: Site URL for authentication redirects
# Development
SITE_URL=http://localhost:3000

# Production (uncomment and set for production deployment)
# SITE_URL=https://yourapp.com

# Optional: Direct PostgreSQL connection string (for migrations/admin tasks)
# Available in Supabase Dashboard > Settings > Database
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.nlzykbtuyoqfdnqtxdyh.supabase.co:5432/postgres

# Legacy PostgreSQL variables (no longer needed with Supabase)
# POSTGRES_URL=postgresql://localhost:5000/myapp
# POSTGRES_USER=appuser
# POSTGRES_PASSWORD=dbuser123
# POSTGRES_DB=myapp
# POSTGRES_PORT=5000
